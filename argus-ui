#!/usr/bin/env bash
# ============================================================================
#  argus-ui — lance l'interface web Argus, accessible par une URL FIXE.
#
#  USAGE
#      ./argus-ui                 # démarre l'interface + vérifie l'accès fixe
#      ./argus-ui --stop          # arrête l'interface (l'accès Tailscale reste)
#      ./argus-ui --status        # où en est-on + l'URL
#
#  ACCÈS (plus de tunnel qui change à chaque fois !)
#      - Local      : http://<ip-lan>:8080
#      - URL FIXE   : https://<votre-machine>.<votre-reseau>.ts.net  <- à installer en PWA
#                     (calculée automatiquement, propre à cette machine)
#
#  POURQUOI UNE URL FIXE : une fois l'appli installée sur le téléphone, elle
#  est liée à son adresse. Un tunnel éphémère (trycloudflare) change à chaque
#  redémarrage -> l'icône installée pointerait dans le vide. Tailscale
#  (`tailscale serve`) donne un nom HTTPS PERMANENT.
#
#  PRÉREQUIS COTÉ TÉLÉPHONE : avoir Tailscale installé et connecté au même
#  compte. Ensuite, ouvrir l'URL fixe et « Ajouter à l'écran d'accueil ».
#  Le réglage `tailscale serve` est persistant : il survit au redémarrage.
# ============================================================================
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${ARGUS_UI_PORT:-8080}"
PID_SRV="$HERE/.ui.pid"
TS_BIN=/usr/bin/tailscale

# L'adresse permanente N'EST PAS figée dans ce script : elle est DEMANDÉE à
# Tailscale, car chaque machine a la sienne. (Piège vécu : une adresse codée en
# dur ferait afficher l'adresse de la machine du développeur chez le client.)
adresse_fixe() {
  [ -x "$TS_BIN" ] || return 1
  "$TS_BIN" serve status 2>/dev/null \
    | grep -oE 'https://[a-z0-9.-]+\.ts\.net' | head -1
}

say() { echo "[argus-ui] $*"; }
ui_actif() { [ -f "$PID_SRV" ] && kill -0 "$(cat "$PID_SRV" 2>/dev/null)" 2>/dev/null; }

# Décrit l'agent en une ligne, quel que soit le mode d'installation.
mode_agent() {
  local deploy="${ARGUS_DEPLOY:-$HOME/projects/argus-deploy}"
  if [ -x "$deploy/argus" ] && docker ps --filter 'name=^argus-confine$' --format '{{.Names}}' 2>/dev/null | grep -q .; then
    "$deploy/argus" --etat 2>/dev/null | head -1
  elif [ -f "$HERE/serveur-ui.py" ]; then
    local m
    m=$(curl -s -m 4 "http://127.0.0.1:$PORT/api/sante" 2>/dev/null | grep -oE '"mode": *"[a-z]+"' | grep -oE 'conteneur|local')
    [ -n "$m" ] && echo "mode $m" || echo "arrêté"
  else
    echo "(inconnu)"
  fi
}

demarrer_ui() {
  if ui_actif; then say "interface déjà en ligne (pid $(cat "$PID_SRV"))."; return 0; fi
  # Déploiement complet (agent isolé) : si le dossier de déploiement existe, on
  # l'indique au serveur — il saura trouver le magasin de notifications partagé
  # et parler au conteneur. Sinon, installation simple : le serveur appellera
  # directement la commande `hermes` de la machine.
  local deploy="${ARGUS_DEPLOY:-$HOME/projects/argus-deploy}"
  [ -d "$deploy" ] && export ARGUS_DEPLOY="$deploy"
  say "démarrage de l'interface (port $PORT)…"
  nohup python3 "$HERE/serveur-ui.py" --port "$PORT" > "$HERE/.ui.log" 2>&1 &
  echo $! > "$PID_SRV"
  for _ in $(seq 1 30); do
    curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/api/sante" && return 0
    sleep 1
  done
  say "ATTENTION : pas de réponse. Voir $HERE/.ui.log"
  return 1
}

# L'accès fixe est un réglage persistant de tailscaled ; on s'assure qu'il
# pointe bien sur notre port (idempotent, silencieux si déjà bon).
assurer_acces_fixe() {
  if [ ! -x "$TS_BIN" ]; then say "tailscale absent — accès local seulement."; return 0; fi
  local etat
  etat=$("$TS_BIN" serve status 2>/dev/null | grep -c "127.0.0.1:$PORT")
  if [ "$etat" -ge 1 ]; then
    say "accès fixe déjà en place."
  else
    say "configuration de l'accès fixe (tailscale serve)…"
    "$TS_BIN" serve --bg --https=443 "http://127.0.0.1:$PORT" >/dev/null 2>&1 \
      && say "accès fixe configuré." \
      || say "ATTENTION : 'tailscale serve' a échoué (voir --status)."
  fi
}

afficher() {
  local ip u
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1)
  [ -n "$ip" ] || ip=127.0.0.1
  u=$(adresse_fixe)
  echo
  echo "  ┌─ ACCÈS À L'INTERFACE ARGUS ──────────────────────────────"
  echo "  │ Local (même Wi-Fi) : http://$ip:$PORT"
  if [ -n "$u" ]; then
    echo "  │ URL FIXE (PWA)     : $u"
    echo "  │   → sur téléphone : ouvrir cette URL une fois, puis"
    echo "  │     « Ajouter à l'écran d'accueil ». Elle NE CHANGE PAS."
    echo "  │   → prérequis : Tailscale installé et connecté sur le téléphone."
  else
    echo "  │ URL FIXE (PWA)     : (pas encore — lancer ./argus-ui)"
  fi
  echo "  └───────────────────────────────────────────────────────────"
  echo
}

case "${1:-}" in
  --stop)
    ui_actif && { kill "$(cat "$PID_SRV")" 2>/dev/null; rm -f "$PID_SRV"; say "interface arrêtée."; }
    say "(l'accès fixe Tailscale reste actif — pour le retirer : $TS_BIN serve --https=443 off)"
    exit 0 ;;

  --status)
    echo "interface : $(ui_actif && echo 'EN LIGNE' || echo 'arrêtée')"
    echo "agent     : $(mode_agent)"
    echo "accès fixe:"; "$TS_BIN" serve status 2>/dev/null | sed 's/^/            /' || echo "            (tailscale indisponible)"
    afficher
    exit 0 ;;
esac

demarrer_ui || exit 1
assurer_acces_fixe
afficher
